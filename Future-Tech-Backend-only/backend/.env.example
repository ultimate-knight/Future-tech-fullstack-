# Copy this file to .env and fill in real values before running the server.
# Never commit your real .env file to version control.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your website URL(s))
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_DIALECT can be: sqlite | postgres | mysql
#
# sqlite   -> zero setup, great for local development/testing. Data is
#             stored in a local file (backend/data/database.sqlite).
# postgres -> recommended for production. Requires a running PostgreSQL
#             server and the DB_* connection values below.
# mysql    -> also production-ready. Requires a running MySQL server and
#             the DB_* connection values below.

DB_DIALECT=mysql

# Only needed when DB_DIALECT=postgres or DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=future_tech
DB_USER=replace-with-real-db-user
DB_PASSWORD=replace-with-real-db-password
# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account, created automatically the first time the server
# starts if no admin exists yet (see src/scripts/seedAdmin.js). Change
# ADMIN_PASSWORD immediately after your first login.
ADMIN_EMAIL=admin@futuretech.org
ADMIN_PASSWORD=change-this-password

# ---------------------------------------------------------------------------
# UPI payments (parent scans a QR code and pays directly into this account;
# an admin manually confirms each payment from the Payments tab after
# checking the bank account/UPI app - see UPI_PAYMENTS.md)
# ---------------------------------------------------------------------------
# Your UPI ID / VPA that should receive payments, e.g. yourschool@okhdfcbank
UPI_VPA=
# Name shown in the payer's UPI app when they scan the code
UPI_PAYEE_NAME=

# ---------------------------------------------------------------------------
# Email (used to send school coordinators their login password)
# ---------------------------------------------------------------------------
# Any SMTP provider works (Gmail, Zoho Mail, SendGrid SMTP relay, etc).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and SMTP_PASSWORD
# must be a 16-character "App Password" (not your normal Gmail password) —
# generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Full URL to your live school-login.html, put in the email body
SCHOOL_PORTAL_LOGIN_URL=http://localhost:8080/school-login.html
# Full URL to your live student-login.html, sent to students once they
# finish creating their own LMS account (welcome email with the portal link)
STUDENT_PORTAL_LOGIN_URL=http://localhost:8080/student-login.html

# ---------------------------------------------------------------------------
# Fees (in INR, whole rupees). Adjust to your real pricing.
# ---------------------------------------------------------------------------
FEE_LEVEL_1=4999
FEE_LEVEL_2=5999
FEE_LEVEL_3=6999
FEE_LEVEL_4=7999
FEE_BULK_PER_STUDENT=3999
FEE_BULK_MINIMUM=19999

# ---------------------------------------------------------------------------
# Settlement invoices (School Accounts tab -> "Generate Invoice")
# ---------------------------------------------------------------------------
# Default platform commission (0-100) deducted from a school's collected
# payments when generating their settlement invoice (GST is then applied on
# top of the commission). Per-school overrides are set via the admin UI.
# Note: Razorpay Route's automatic per-order settlement split has been
# retired along with Razorpay checkout - see UPI_PAYMENTS.md. Schools are
# now settled entirely through these invoices instead. The Route-specific
# env vars and RAZORPAY_ROUTE.md are obsolete and can be ignored/removed.
PLATFORM_COMMISSION_PERCENT=0

